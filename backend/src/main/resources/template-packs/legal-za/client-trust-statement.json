{
  "type": "doc",
  "content": [
    {
      "type": "conditionalBlock",
      "attrs": { "fieldKey": "org.logoUrl", "operator": "isNotEmpty" },
      "content": [
        {
          "type": "paragraph",
          "content": [
            { "type": "variable", "attrs": { "key": "org.logoUrl" } }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": { "level": 1 },
      "content": [
        { "type": "variable", "attrs": { "key": "org.name" } }
      ]
    },
    {
      "type": "conditionalBlock",
      "attrs": { "fieldKey": "org.address", "operator": "isNotEmpty" },
      "content": [
        {
          "type": "paragraph",
          "content": [
            { "type": "variable", "attrs": { "key": "org.address" } }
          ]
        }
      ]
    },
    {
      "type": "conditionalBlock",
      "attrs": { "fieldKey": "org.phone", "operator": "isNotEmpty" },
      "content": [
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "marks": [{ "type": "bold" }], "text": "Tel:" },
            { "type": "text", "text": " " },
            { "type": "variable", "attrs": { "key": "org.phone" } }
          ]
        }
      ]
    },
    {
      "type": "conditionalBlock",
      "attrs": { "fieldKey": "org.email", "operator": "isNotEmpty" },
      "content": [
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "marks": [{ "type": "bold" }], "text": "Email:" },
            { "type": "text", "text": " " },
            { "type": "variable", "attrs": { "key": "org.email" } }
          ]
        }
      ]
    },
    {
      "type": "conditionalBlock",
      "attrs": { "fieldKey": "org.website", "operator": "isNotEmpty" },
      "content": [
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "marks": [{ "type": "bold" }], "text": "Web:" },
            { "type": "text", "text": " " },
            { "type": "variable", "attrs": { "key": "org.website" } }
          ]
        }
      ]
    },
    {
      "type": "conditionalBlock",
      "attrs": { "fieldKey": "org.taxRegistrationNumber", "operator": "isNotEmpty" },
      "content": [
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "marks": [{ "type": "bold" }], "text": "VAT Registration No:" },
            { "type": "text", "text": " " },
            { "type": "variable", "attrs": { "key": "org.taxRegistrationNumber" } }
          ]
        }
      ]
    },
    { "type": "horizontalRule" },
    {
      "type": "heading",
      "attrs": { "level": 2 },
      "content": [
        { "type": "text", "text": "Client Trust Statement" }
      ]
    },
    { "type": "horizontalRule" },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "marks": [{ "type": "bold" }], "text": "Client:" },
        { "type": "text", "text": " " },
        { "type": "variable", "attrs": { "key": "customer.name" } }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "marks": [{ "type": "bold" }], "text": "Statement Date:" },
        { "type": "text", "text": " " },
        { "type": "variable", "attrs": { "key": "generatedAt" } }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "marks": [{ "type": "bold" }], "text": "Trust Account:" },
        { "type": "text", "text": " " },
        { "type": "variable", "attrs": { "key": "org.name" } },
        { "type": "text", "text": " — Section 86(2) trust account" }
      ]
    },
    { "type": "horizontalRule" },
    {
      "type": "heading",
      "attrs": { "level": 3 },
      "content": [
        { "type": "text", "text": "Transaction Summary" }
      ]
    },
    {
      "type": "conditionalBlock",
      "attrs": { "fieldKey": "trust.account_name", "operator": "isNotEmpty" },
      "content": [
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "text": "The following is a statement of all trust account transactions held on behalf of " },
            { "type": "variable", "attrs": { "key": "customer.name" } },
            { "type": "text", "text": ", from the first transaction to the date of this statement." }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "marks": [{ "type": "bold" }], "text": "Account:" },
            { "type": "text", "text": " " },
            { "type": "variable", "attrs": { "key": "trust.account_name" } }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "marks": [{ "type": "bold" }], "text": "Opening balance:" },
            { "type": "text", "text": " " },
            { "type": "variable", "attrs": { "key": "trust.opening_balance" } }
          ]
        },
        {
          "type": "loopTable",
          "attrs": {
            "dataSource": "trust.lines",
            "columns": [
              { "header": "Date", "key": "transactionDate", "format": "date" },
              { "header": "Type", "key": "type" },
              { "header": "Reference", "key": "reference" },
              { "header": "Description", "key": "description" },
              { "header": "Amount", "key": "amount", "format": "currency" },
              { "header": "Balance", "key": "runningBalance", "format": "currency" }
            ]
          }
        },
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "marks": [{ "type": "bold" }], "text": "Closing balance:" },
            { "type": "text", "text": " " },
            { "type": "variable", "attrs": { "key": "trust.closing_balance" } }
          ]
        }
      ]
    },
    {
      "type": "conditionalBlock",
      "attrs": { "fieldKey": "trust.invested.closing_balance", "operator": "isNotEmpty" },
      "content": [
        {
          "type": "heading",
          "attrs": { "level": 3 },
          "content": [
            { "type": "text", "text": "Section 86(4) investment" }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "marks": [{ "type": "bold" }], "text": "Placed in section 86(4) investment:" },
            { "type": "text", "text": " " },
            { "type": "variable", "attrs": { "key": "trust.invested.capital_placed" } }
          ]
        },
        {
          "type": "conditionalBlock",
          "attrs": { "fieldKey": "trust.invested.interest_entries", "operator": "isNotEmpty" },
          "content": [
            {
              "type": "paragraph",
              "content": [
                { "type": "text", "marks": [{ "type": "bold" }], "text": "Section 86(4) investment interest" }
              ]
            },
            {
              "type": "loopTable",
              "attrs": {
                "dataSource": "trust.invested.interest_entries",
                "columns": [
                  { "header": "Date", "key": "entryDate", "format": "date" },
                  { "header": "Gross interest", "key": "grossAmount", "format": "currency" },
                  { "header": "Fund share of section 86(4) interest (5%)", "key": "fundShareAmount", "format": "currency" },
                  { "header": "Net interest", "key": "netAmount", "format": "currency" }
                ]
              }
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "marks": [{ "type": "bold" }], "text": "Gross interest:" },
            { "type": "text", "text": " " },
            { "type": "variable", "attrs": { "key": "trust.invested.interest_gross" } }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "marks": [{ "type": "bold" }], "text": "Fund share of section 86(4) interest (5%):" },
            { "type": "text", "text": " " },
            { "type": "variable", "attrs": { "key": "trust.invested.interest_fund_share" } }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "marks": [{ "type": "bold" }], "text": "Net interest:" },
            { "type": "text", "text": " " },
            { "type": "variable", "attrs": { "key": "trust.invested.interest_net" } }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "marks": [{ "type": "bold" }], "text": "Investment returned to trust:" },
            { "type": "text", "text": " " },
            { "type": "variable", "attrs": { "key": "trust.invested.returned_to_trust" } }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "marks": [{ "type": "bold" }], "text": "Invested on your instruction (section 86(4)):" },
            { "type": "text", "text": " " },
            { "type": "variable", "attrs": { "key": "trust.invested.closing_balance" } }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": { "level": 3 },
      "content": [
        { "type": "text", "text": "Current Balance" }
      ]
    },
    {
      "type": "conditionalBlock",
      "attrs": { "fieldKey": "trust.account_name", "operator": "isNotEmpty" },
      "content": [
        {
          "type": "conditionalBlock",
          "attrs": { "fieldKey": "trust.invested.closing_balance", "operator": "isEmpty" },
          "content": [
            {
              "type": "paragraph",
              "content": [
                { "type": "text", "text": "The current balance held in trust on your behalf is " },
                { "type": "variable", "attrs": { "key": "trust.closing_balance" } },
                { "type": "text", "text": "." }
              ]
            }
          ]
        },
        {
          "type": "conditionalBlock",
          "attrs": { "fieldKey": "trust.invested.closing_balance", "operator": "isNotEmpty" },
          "content": [
            {
              "type": "paragraph",
              "content": [
                { "type": "text", "marks": [{ "type": "bold" }], "text": "In the firm's trust account:" },
                { "type": "text", "text": " " },
                { "type": "variable", "attrs": { "key": "trust.closing_balance" } }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                { "type": "text", "marks": [{ "type": "bold" }], "text": "Invested on your instruction (section 86(4)):" },
                { "type": "text", "text": " " },
                { "type": "variable", "attrs": { "key": "trust.invested.closing_balance" } }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                { "type": "text", "marks": [{ "type": "bold" }], "text": "Held in trust:" },
                { "type": "text", "text": " " },
                { "type": "variable", "attrs": { "key": "trust.invested.total_held" } }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "conditionalBlock",
      "attrs": { "fieldKey": "trust.status", "operator": "eq", "value": "none" },
      "content": [
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "text": "No trust account transactions have been recorded on your behalf, and no money is held in trust for you." }
          ]
        }
      ]
    },
    {
      "type": "conditionalBlock",
      "attrs": { "fieldKey": "trust.status", "operator": "isEmpty" },
      "content": [
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "text": "Trust details are not available." }
          ]
        }
      ]
    },
    { "type": "horizontalRule" },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "text": "This statement is issued in terms of the Legal Practice Act 28 of 2014 and the rules of the Legal Practice Council." }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "text": "Yours faithfully," }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "variable", "attrs": { "key": "org.name" } }
      ]
    }
  ]
}
