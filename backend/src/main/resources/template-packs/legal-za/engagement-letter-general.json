    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "text": "We are pleased to confirm our engagement to provide legal services as outlined below. This letter sets out the terms and conditions under which " },
        { "type": "variable", "attrs": { "key": "org.name" } },
        { "type": "text", "text": " will render services to you." }
