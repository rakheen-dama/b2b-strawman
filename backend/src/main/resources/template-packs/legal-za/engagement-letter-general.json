        { "type": "text", "text": " " },
        { "type": "variable", "attrs": { "key": "customer.name" } }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "marks": [{ "type": "bold" }], "text": "Matter:" },
        { "type": "text", "text": " " },
        { "type": "variable", "attrs": { "key": "project.name" } }
      ]
    },
    {
      "type": "heading",
      "attrs": { "level": 3 },
      "content": [
        { "type": "text", "text": "Scope of Services" }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "text": "We are instructed to provide general legal advisory services in connection with the above matter. The specific scope of work will be agreed upon and may include legal opinions, contract drafting and review, regulatory advice, and general legal counsel." }
      ]
    },
    {
      "type": "heading",
      "attrs": { "level": 3 },
      "content": [
        { "type": "text", "text": "Terms and Conditions" }
      ]
    },
    { "type": "clauseBlock", "attrs": { "slug": "legal-za-mandate-scope" } },
    { "type": "clauseBlock", "attrs": { "slug": "legal-za-fees-hourly" } },
    { "type": "clauseBlock", "attrs": { "slug": "legal-za-termination" } },
    { "type": "clauseBlock", "attrs": { "slug": "legal-za-data-protection" } },
    { "type": "clauseBlock", "attrs": { "slug": "legal-za-jurisdiction" } },
    {
      "type": "heading",
      "attrs": { "level": 3 },
      "content": [
        { "type": "text", "text": "Acceptance" }
