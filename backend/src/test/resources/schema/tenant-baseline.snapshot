## check_constraints (123)
<tenant> | accounting_sync_entry | ck_ase_direction | (((direction)::text = ANY ((ARRAY['PUSH'::character varying, 'PULL'::character varying])::text[])))
<tenant> | accounting_sync_entry | ck_ase_entity_type | (((entity_type)::text = ANY ((ARRAY['INVOICE'::character varying, 'CUSTOMER'::character varying, 'PAYMENT_PULL'::character varying])::text[])))
<tenant> | accounting_sync_entry | ck_ase_state | (((state)::text = ANY ((ARRAY['PENDING'::character varying, 'IN_FLIGHT'::character varying, 'COMPLETED'::character varying, 'FAILED_RETRYING'::character varying, 'DEAD_LETTER'::character varying, 'BLOCKED_TRUST_BOUNDARY'::character varying, 'RECONCILE_DRIFT'::character varying])::text[])))
<tenant> | accounting_sync_entry | ck_ase_trigger | (((trigger)::text = ANY ((ARRAY['EVENT'::character varying, 'MANUAL_RETRY'::character varying, 'FORCE_RESYNC'::character varying])::text[])))
<tenant> | accounting_tax_code_mapping | ck_atcm_kazi_tax_mode | (((kazi_tax_mode)::text = ANY ((ARRAY['STANDARD_15'::character varying, 'ZERO_RATED'::character varying, 'EXEMPT'::character varying, 'OUT_OF_SCOPE'::character varying, 'STANDARD_OTHER'::character varying])::text[])))
<tenant> | accounting_xero_connection | ck_axc_status | (((status)::text = ANY ((ARRAY['CONNECTED'::character varying, 'REFRESH_FAILED'::character varying, 'REVOKED'::character varying])::text[])))
<tenant> | automation_actions | chk_delay_both_or_neither | ((((delay_duration IS NULL) AND (delay_unit IS NULL)) OR ((delay_duration IS NOT NULL) AND (delay_unit IS NOT NULL))))
<tenant> | bank_statement_lines | chk_bank_line_confidence | (((match_confidence IS NULL) OR ((match_confidence >= (0)::numeric) AND (match_confidence <= (1)::numeric))))
<tenant> | bank_statement_lines | chk_bank_line_match_status | (((match_status)::text = ANY ((ARRAY['UNMATCHED'::character varying, 'AUTO_MATCHED'::character varying, 'MANUALLY_MATCHED'::character varying, 'EXCLUDED'::character varying])::text[])))
<tenant> | bank_statements | chk_bank_stmt_counts | (((line_count >= 0) AND (matched_count >= 0) AND (matched_count <= line_count)))
<tenant> | bank_statements | chk_bank_stmt_format | (((format)::text = ANY ((ARRAY['CSV'::character varying, 'OFX'::character varying])::text[])))
<tenant> | bank_statements | chk_bank_stmt_period | ((period_end >= period_start))
<tenant> | bank_statements | chk_bank_stmt_status | (((status)::text = ANY ((ARRAY['IMPORTED'::character varying, 'MATCHING_IN_PROGRESS'::character varying, 'MATCHED'::character varying, 'RECONCILED'::character varying])::text[])))
<tenant> | billing_rates | chk_billing_rate_currency_len | ((char_length((currency)::text) = 3))
