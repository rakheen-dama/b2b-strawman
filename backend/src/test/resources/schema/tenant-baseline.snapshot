<tenant> | checklist_instance_items | chk_verification_status | (((verification_status IS NULL) OR ((verification_status)::text = ANY ((ARRAY['VERIFIED'::character varying, 'NOT_VERIFIED'::character varying, 'NEEDS_REVIEW'::character varying])::text[]))))
